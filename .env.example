# AgriCredit Agent configuration. Copy to .env (run_demo.sh does this on first run).

# ---- Language model (open-weight by default) --------------------------------------------
# ollama             local Ollama server with a Qwen instruct model (default)
# openai_compatible  any OpenAI-compatible server (vLLM, llama.cpp server, LM Studio) serving Qwen
# stub               offline deterministic stand-in, NOT a language model (CI / no model runtime)
AGRICREDIT_LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Qwen2.5-7B-Instruct: strong JSON/instruction following, runs on CPU with ~8 GB RAM (Q4) or any 8 GB GPU.
# qwen3:8b also works (thinking is switched off automatically).
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_COMPATIBLE_API_KEY=not-needed
AGRICREDIT_LLM_TIMEOUT_S=180

# ---- Paths (relative to the repository root) ---------------------------------------------
AGRICREDIT_DB_PATH=data/agricredit.db
AGRICREDIT_LOG_DIR=logs
AGRICREDIT_RISK_MODEL_PATH=data/risk_model.joblib
# Root the official MCP filesystem server may access: policy, eval fixtures, audit exports only.
AGRICREDIT_FS_MCP_ROOT=fs_mcp_root

# ---- Stress test shocks (fractions) ---------------------------------------------------------
AGRICREDIT_YIELD_SHOCK_PCT=0.20
AGRICREDIT_PRICE_SHOCK_PCT=0.10

# ---- Approval gate ---------------------------------------------------------------------------
AGRICREDIT_APPROVAL_TTL_HOURS=72
# If true, an approval is void when the LLM model version changes (hash and evidence changes always void it).
AGRICREDIT_MODEL_VERSION_APPROVAL_SENSITIVE=true

# ---- Fault injection (evaluation and demo only; leave empty) -------------------------------
AGRICREDIT_FAULTS=
