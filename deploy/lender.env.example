# Copy this file to ".env" in the agricredit-agent folder to change settings, then run
#   docker compose up -d
# Every line is optional.

# Port the dashboard listens on (open http://localhost:8501).
AGRICREDIT_PORT=8501

# Language of the explanation: fr or en.
AGRICREDIT_ADVISORY_LANGUAGE=fr

# Model. qwen2.5:7b-instruct needs about 8 GB of free memory; qwen2.5:3b-instruct is lighter.
OLLAMA_MODEL=qwen2.5:7b-instruct

# "stub" turns AI writing off: explanations use the fixed template. Decisions do not change.
AGRICREDIT_LLM_BACKEND=ollama

# Ollama release to run (change only if the download fails).
OLLAMA_VERSION=0.40.10

# Optional first account, created at start-up: username:password:OFFICER-ID
# Prefer "docker compose exec app python -m agricredit.auth add ..." and leave this empty.
AGRICREDIT_BOOTSTRAP_USERS=
